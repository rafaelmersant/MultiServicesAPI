DJANGO_SECRET_KEY=
DGII_ENVIRONMENT=precert
ECF_EXPECTED_TAX_ID=

# La URL exacta será configurada según el ambiente
# y documentación vigente de DGII.
DGII_BASE_URL=

DGII_TIMEOUT_SECONDS=30
# Optional absolute private directory; defaults to BASE_DIR/private_ecf_state.
# Must be writable by Gunicorn and included in backups; never serve through Nginx.
# ECF_PRODUCTION_REGISTRY_DIR=/home/privatefiles/ecf-state

ECF_CERTIFICATE_PATH=
ECF_CERTIFICATE_PASSWORD=
ECF_TRUSTED_CA_PATH=/ruta/al/certificado-raiz-dgii.cer
ECF_REQUIRE_INBOUND_AUTH=false
ECF_AUTH_TOKEN_SECRET=
ECF_AUTH_TRUSTED_CA_PATH=/ruta/al/paquete-ca-psc.pem

# Optional explicit signer certificate SHA256 fingerprints, comma-separated.
# Active ONLY with DGII_ENVIRONMENT=cert. Empty keeps mandatory CA validation.
# Production/precert always use the CA chain, even if this variable is set.
ECF_CERT_TRUSTED_SIGNER_SHA256=

ECF_TEST_SET_PATH=/ruta/al/Set_de_pruebas.xlsx
