DJANGO_SETTINGS_MODULE=MultiServices.settings_certification
DGII_ENVIRONMENT=cert
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=certificacion.sistemacenter.org
ECF_CERTIFICATION_DB=/var/lib/multiservices-certification/db.sqlite3
ECF_CERTIFICATION_MEDIA=/var/lib/multiservices-certification/media
ECF_EXPECTED_TAX_ID=132018559
ECF_CERTIFICATE_PATH=/etc/multiservices-certification/certifica.p12
ECF_CERTIFICATE_PASSWORD=
ECF_TRUSTED_CA_PATH=/etc/multiservices-certification/dgii-root.pem
ECF_AUTH_TRUSTED_CA_PATH=/etc/multiservices-certification/trusted-signers.pem
ECF_REQUIRE_INBOUND_AUTH=true
ECF_AUTH_TOKEN_SECRET=
DGII_TIMEOUT_SECONDS=30
